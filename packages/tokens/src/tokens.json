{
  "$description": "Design tokens extraídos de federicocarrone.com (main.css :root + estilos computados, medido el 2026-11-24). Formato W3C DTCG. Tema oscuro global; las páginas de lectura usan además una hoja blanca (ver tokens.css, bloque .paper).",

  "color": {
    "primitive": {
      "ink-950":   { "$value": "#0a0a0b", "$type": "color", "$description": "Fondo de página (--color-light). También theme-color." },
      "ink-900":   { "$value": "#131316", "$type": "color", "$description": "Fondo de bloques de código (--color-code)" },
      "ink-850":   { "$value": "#141416", "$type": "color", "$description": "Superficie elevada: tiles, paneles (--color-lighter)" },
      "ink-800":   { "$value": "#1b1b1e", "$type": "color", "$description": "Superficie alternativa (--color-dark-blue)" },
      "ink-700":   { "$value": "#2a2a2d", "$type": "color", "$description": "Reglas y bordes (--color-dark-lighter / --color-rule)" },
      "stone-500": { "$value": "#8e8e88", "$type": "color", "$description": "Texto terciario: labels, meta, créditos (--color-light-darker)" },
      "stone-300": { "$value": "#c8c8c2", "$type": "color", "$description": "Texto secundario: dek, bajadas (--color-muted)" },
      "paper-100": { "$value": "#ededea", "$type": "color", "$description": "Texto principal (--color-dark)" },
      "white":     { "$value": "#ffffff", "$type": "color" },
      "periwinkle-300": { "$value": "#9db2ff", "$type": "color", "$description": "Acento (--color-accent)" },
      "periwinkle-200": { "$value": "#c4d0ff", "$type": "color", "$description": "Acento claro: subrayado hover (--color-accent-darker)" },
      "periwinkle-700": { "$value": "#3b5bdb", "$type": "color", "$description": "Acento sobre la hoja blanca: foco y subrayado de hover en .paper (5,7:1, WCAG 1.4.11)" }
    },
    "dataviz": {
      "green":  { "$value": "#a9c98a", "$type": "color", "$description": "Nodos del grafo (grupo 1)" },
      "blue":   { "$value": "#8fa7d9", "$type": "color", "$description": "Nodos del grafo (grupo 2)" },
      "orange": { "$value": "#e08f6a", "$type": "color", "$description": "Nodos del grafo (grupo 3)" }
    },
    "semantic": {
      "bg.page":         { "$value": "{color.primitive.ink-950}",  "$type": "color" },
      "bg.surface":      { "$value": "{color.primitive.ink-850}",  "$type": "color" },
      "bg.surface-alt":  { "$value": "{color.primitive.ink-800}",  "$type": "color" },
      "bg.code":         { "$value": "{color.primitive.ink-900}",  "$type": "color" },
      "text.primary":    { "$value": "{color.primitive.paper-100}","$type": "color" },
      "text.secondary":  { "$value": "{color.primitive.stone-300}","$type": "color" },
      "text.tertiary":   { "$value": "{color.primitive.stone-500}","$type": "color" },
      "text.on-image":   { "$value": "{color.primitive.paper-100}","$type": "color" },
      "border.subtle":   { "$value": "{color.primitive.ink-700}",  "$type": "color" },
      "link.default":    { "$value": "{color.primitive.paper-100}","$type": "color", "$description": "Los links de la home heredan el color del texto y se distinguen por subrayado" },
      "link.accent":     { "$value": "{color.primitive.periwinkle-300}", "$type": "color", "$description": "Links dentro de artículos" },
      "link.underline-hover": { "$value": "{color.primitive.periwinkle-200}", "$type": "color" },
      "overlay.hero-top":    { "$value": "rgba(10,10,11,0.72)", "$type": "color", "$description": "Borde de arriba del hero; baja a 0,62 a 4,5rem (cabecera) y a 0 a 12rem" },
      "overlay.hero-text":   { "$value": "rgba(10,10,11,0.62)", "$type": "color", "$description": "Mínimo detrás del texto del hero: hasta 28rem del borde de abajo (text-primary 4,5:1 sobre una foto blanca)" },
      "overlay.hero-bottom": { "$value": "rgba(10,10,11,0.94)", "$type": "color" },
      "overlay.tile-top":    { "$value": "rgba(10,10,11,0.55)", "$type": "color", "$description": "Tiles: degradé original (0,55 → 0 a 22% → 0,1 a 45% → 0,94)" },
      "paper.link-accent":   { "$value": "{color.primitive.periwinkle-700}", "$type": "color", "$description": "--link-accent y --link-underline-hover dentro de .paper" }
    }
  },

  "font": {
    "family": {
      "display": { "$value": "Gloock, \"Iowan Old Style\", Georgia, serif", "$type": "fontFamily", "$description": "Títulos de cards, tiles, brand" },
      "text":    { "$value": "Pagella, Palatino, \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif", "$type": "fontFamily", "$description": "Cuerpo y H1 del hero" },
      "ui":      { "$value": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif", "$type": "fontFamily", "$description": "Nav, labels, meta, footer" },
      "mono":    { "$value": "ui-monospace, \"Cascadia Code\", \"Source Code Pro\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight", "$description": "Solo Pagella (cuerpo en negrita)" }
    },
    "size": {
      "2xs":  { "$value": "0.75rem",   "$type": "dimension", "$description": "12px — eyebrow, h2 de sección, créditos" },
      "xs":   { "$value": "0.8125rem", "$type": "dimension", "$description": "13px — meta (fecha · lectura)" },
      "sm":   { "$value": "0.9rem",    "$type": "dimension", "$description": "14.4px — footer" },
      "ui":   { "$value": "0.95rem",   "$type": "dimension", "$description": "15.2px — nav, links de entrada, subtítulo de tile" },
      "base": { "$value": "1rem",      "$type": "dimension", "$description": "16px — dek de card" },
      "lead": { "$value": "1.15rem",   "$type": "dimension", "$description": "18.4px — dek de la nota destacada" },
      "body": { "$value": "1.1875rem", "$type": "dimension", "$description": "19px — texto base (--text-size)" },
      "title-sm": { "$value": "1.4rem",  "$type": "dimension", "$description": "22.4px — título de lista numerada" },
      "title-md": { "$value": "1.6rem",  "$type": "dimension", "$description": "25.6px — título de card" },
      "title-lg": { "$value": "1.8rem",  "$type": "dimension", "$description": "28.8px — título de tile" },
      "brand":    { "$value": "1.75rem", "$type": "dimension", "$description": "28px — marca en el footer" },
      "fluid.hero-h1":   { "$value": "clamp(2.4rem, 5.6vw, 4.6rem)",  "$type": "dimension" },
      "fluid.hero-dek":  { "$value": "clamp(1.05rem, 1.35vw, 1.25rem)", "$type": "dimension" },
      "fluid.lead-title":{ "$value": "clamp(2rem, 3.6vw, 3rem)",      "$type": "dimension" }
    },
    "lineHeight": {
      "hero":   { "$value": 1.02,  "$type": "number" },
      "tight":  { "$value": 1.05,  "$type": "number", "$description": "Título de nota destacada" },
      "snug":   { "$value": 1.1,   "$type": "number", "$description": "Títulos de card/tile (1.08–1.12)" },
      "title":  { "$value": 1.2,   "$type": "number" },
      "dek":    { "$value": 1.5,   "$type": "number" },
      "body":   { "$value": 1.55,  "$type": "number", "$description": "--text-line-height" }
    },
    "letterSpacing": {
      "label": { "$value": "0.12em", "$type": "dimension", "$description": "Uppercase pequeño (eyebrow, h2 de sección, footer h2)" }
    }
  },

  "space": {
    "0-2": { "$value": "0.2rem",  "$type": "dimension" },
    "0-25":{ "$value": "0.25rem", "$type": "dimension" },
    "0-5": { "$value": "0.5rem",  "$type": "dimension" },
    "0-7": { "$value": "0.7rem",  "$type": "dimension", "$description": "11.2px — gap interno de card" },
    "0-9": { "$value": "0.9rem",  "$type": "dimension", "$description": "14.4px — gap de posters; padding bajo section-head" },
    "1":   { "$value": "1rem",    "$type": "dimension" },
    "1-1": { "$value": "1.1rem",  "$type": "dimension", "$description": "Gap dentro del cuerpo del hero" },
    "1-25":{ "$value": "1.25rem", "$type": "dimension", "$description": "20px — padding de tile/panel, gap de grillas de tiles" },
    "1-5": { "$value": "1.5rem",  "$type": "dimension" },
    "1-75":{ "$value": "1.75rem", "$type": "dimension", "$description": "28px — gap entre section-head y contenido; gap columnas de cards" },
    "2":   { "$value": "2rem",    "$type": "dimension" },
    "2-5": { "$value": "2.5rem",  "$type": "dimension", "$description": "40px — gap de lead-story y de lista numerada" },
    "2-75":{ "$value": "2.75rem", "$type": "dimension", "$description": "44px — gap de filas de cards" },
    "3":   { "$value": "3rem",    "$type": "dimension" },
    "3-5": { "$value": "3.5rem",  "$type": "dimension", "$description": "Padding inferior del hero" },
    "5":   { "$value": "5rem",    "$type": "dimension", "$description": "Padding superior de cada sección" },
    "7":   { "$value": "7rem",    "$type": "dimension", "$description": "Padding superior del hero" },
    "gutter": { "$value": "clamp(1rem, 3.75vw, 3rem)", "$type": "dimension", "$description": "Margen lateral de página (--gutter): 16px en mobile → 48px desde ~1280px" }
  },

  "size": {
    "prose-width":   { "$value": "35em",  "$type": "dimension", "$description": "Columna de lectura (665px a 19px)" },
    "hero-body-max": { "$value": "58rem", "$type": "dimension" },
    "hero-dek-max":  { "$value": "36em",  "$type": "dimension" },
    "hero-min-height": { "$value": "100vh", "$type": "dimension", "$description": "En la home el hero ocupa todo el viewport (medido 900px/911px)" }
  },

  "border": {
    "width": {
      "hairline": { "$value": "1px", "$type": "dimension", "$description": "Reglas de sección, listas, footer" },
      "strong":   { "$value": "2px", "$type": "dimension", "$description": "--border-width (citas, código)" }
    },
    "radius": { "none": { "$value": "0", "$type": "dimension", "$description": "Todo el sitio usa esquinas rectas" } }
  },

  "shadow": { "none": { "$value": "none", "$type": "shadow", "$description": "No se detectaron sombras" } },

  "motion": {
    "duration": { "fast": { "$value": "150ms", "$type": "duration" } },
    "note": "Solo hay transiciones sutiles (opacity .15s en anclas de títulos). Existe @media (prefers-reduced-motion: reduce)."
  },

  "breakpoint": {
    "$description": "Breakpoints presentes en main.css. En CSS no se pueden usar variables dentro de @media: se documentan acá y se usan literales.",
    "sm":  { "$value": "600px",  "$type": "dimension" },
    "sm2": { "$value": "700px",  "$type": "dimension" },
    "md":  { "$value": "800px",  "$type": "dimension", "$description": "Par 800/801: salto a 2 columnas de lead-story/explore" },
    "nav": { "$value": "900px",  "$type": "dimension", "$description": "Por debajo: nav colapsa a botón ☰" },
    "lg":  { "$value": "75em",   "$type": "dimension", "$description": "1200px — cards pasan de 2 columnas a auto-fill" }
  },

  "aspect": {
    "lead-image": { "$value": "16 / 9",  "$type": "string", "$description": "medido 1.78" },
    "card-image": { "$value": "16 / 10", "$type": "string", "$description": "medido 1.60" },
    "tile":       { "$value": "6 / 5",   "$type": "string", "$description": "medido 1.20" },
    "poster":     { "$value": "2 / 3",   "$type": "string", "$description": "medido 0.67" }
  },

  "layout": {
    "grid": {
      "start-list": { "$value": "repeat(auto-fill, minmax(min(100%, 22rem), 1fr))", "$type": "string", "$description": "gap 0 2.5rem. Observado: 1 col (≤1024), 2 col (1440), 3 col (1920)" },
      "lead-story": { "$value": "1.5fr 1fr", "$type": "string", "$description": "gap 2.5rem; 1 col hasta ~800px" },
      "card-grid":  { "$value": "repeat(auto-fill, minmax(18rem, 1fr))", "$type": "string", "$description": "gap 2.75rem 1.75rem. Por debajo de 75em: 2 col; 1 col en mobile" },
      "explore":    { "$value": "1.5fr 1fr", "$type": "string", "$description": "gap 1.25rem; 1 col hasta ~800px" },
      "tile-grid":  { "$value": "repeat(auto-fill, minmax(16rem, 1fr))", "$type": "string", "$description": "gap 1.25rem" },
      "poster-strip": { "$value": "repeat(8, 1fr)", "$type": "string", "$description": "gap 0.9rem; 8 columnas en todos los viewports" },
      "footer":     { "$value": "2fr 1fr 1fr 1fr", "$type": "string", "$description": "gap 2rem 3rem; 2 col en ≤768px" }
    }
  }
}
