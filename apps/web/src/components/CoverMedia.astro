---
import ResponsiveImage from './ResponsiveImage.astro';
import type { Cover } from '../lib/cover.ts';

interface Props {
  cover: Cover;
  /** Crop ratio: lead 16:9, card 16:10, tile 6:5, hero = fills the container. */
  ratio: 'lead' | 'card' | 'tile' | 'hero';
  /** The page's first visible image is not deferred. */
  eager?: boolean;
  /** Forces an empty alt (the image goes with a title that already describes it). */
  decorative?: boolean;
}

const { cover, ratio, eager = false, decorative = false } = Astro.props;
// Reserved box for images that are not uploaded assets (those have known sizes): no layout shifts.
const size = { lead: [1600, 900], card: [1600, 1000], tile: [1200, 1000], hero: [1920, 1080] }[ratio];
---

<div class={`media media--${ratio}`}>
  {
    cover.kind === 'image' ? (
      <ResponsiveImage
        src={cover.src}
        alt={decorative ? '' : cover.alt}
        context={ratio}
        priority={eager}
        width={size[0]}
        height={size[1]}
      />
    ) : (
      <Fragment set:html={cover.svg} />
    )
  }
</div>
