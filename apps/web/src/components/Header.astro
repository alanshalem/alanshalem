---
import { LANGUAGE_NAMES, navCurrent, navLinks, paths, switcherLinks, ui, type Alternates, type Lang } from '../lib/i18n.ts';
import { getSettings } from '../lib/settings.ts';

interface Props {
  lang: Lang;
  currentPath: string;
  alternates: Alternates;
  switchFallback?: ((lang: Lang) => string) | undefined;
  /** Transparente y superpuesta al hero (home y artículo). */
  overlay?: boolean;
}

const { lang, currentPath, alternates, switchFallback, overlay = false } = Astro.props;
const settings = await getSettings(lang);
const t = ui(lang);
const languages = switcherLinks(lang, alternates, switchFallback);
// El feed no es una sección del sitio: nunca queda marcado.
const current = (href: string) => (href === paths.rss(lang) ? undefined : navCurrent(currentPath, href));
// Los enlaces del menú, armados una vez para sus dos lugares (fila de escritorio y panel del ☰).
const links = navLinks(lang).map((item) => ({
  label: item.label,
  href: item.href,
  'aria-label': item.ariaLabel,
  type: item.href === paths.rss(lang) ? 'application/rss+xml' : undefined,
  'aria-current': current(item.href),
}));
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <a class="brand" href={paths.home(lang)}>{settings.name}</a>

  {/*
    En el HTML, en el orden en que se ve (WCAG 2.4.3, L13), sin `order` en el CSS. Escritorio: links · ES | EN.
    Celular: ES | EN · ☰ y su panel, que se despliega debajo. Como los links van antes de ES | EN en un tamaño y
    después en el otro, el menú tiene dos lugares que salen de la misma lista y el CSS muestra uno solo por tamaño:
    el oculto (display: none) no se enfoca ni lo anuncia el lector de pantalla.
  */}
  <div class="header-tools">
    <nav class="site-nav site-nav--bar" aria-label={t.mainNav}>
      {links.map(({ label, ...attributes }) => <a {...attributes}>{label}</a>)}
    </nav>
    <nav class="lang-switch" aria-label={t.languageNav}>
      {
        languages.map((link) => (
          <a
            href={link.href}
            hreflang={link.lang}
            lang={link.lang}
            title={LANGUAGE_NAMES[link.lang]}
            aria-current={link.current ? 'true' : undefined}
          >
            {link.lang.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.menu}>☰</button>
    <nav id="site-nav" class="site-nav site-nav--menu" aria-label={t.mainNav}>
      {links.map(({ label, ...attributes }) => <a {...attributes}>{label}</a>)}
    </nav>
  </div>
</header>

<script>
  // Único JavaScript de la cabecera: el menú desplegable de pantallas angostas (patrón disclosure). Se abre y cierra
  // con ☰ y además se cierra con Esc, con un clic afuera y cuando el foco sale de él (P3, L4): abierto, tapaba el
  // contenido al seguir con Tab o al tocar la página. En pantallas anchas ni ☰ ni el panel se ven (los links van en
  // la fila) y esto no cambia nada.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('site-nav');
  if (toggle && menu) {
    const isOpen = (): boolean => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean): void => toggle.setAttribute('aria-expanded', String(open));
    const inside = (target: EventTarget | null): boolean =>
      target instanceof Node && (toggle.contains(target) || menu.contains(target));

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      // Si el foco estaba en el menú, vuelve al botón: el panel que se cierra no se lo lleva.
      const focusWasInside = inside(document.activeElement);
      setOpen(false);
      if (focusWasInside) toggle.focus();
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !inside(event.target)) setOpen(false);
    });
    // `relatedTarget` es adónde va el foco; null = a ningún control (clic en texto, otra ventana): eso lo cierra el clic.
    const closeWhenFocusLeaves = (event: FocusEvent): void => {
      if (isOpen() && event.relatedTarget !== null && !inside(event.relatedTarget)) setOpen(false);
    };
    toggle.addEventListener('focusout', closeWhenFocusLeaves);
    menu.addEventListener('focusout', closeWhenFocusLeaves);
  }
</script>
