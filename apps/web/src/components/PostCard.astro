---
import CoverMedia from './CoverMedia.astro';
import { formatDate, interpolate, ui } from '../lib/i18n.ts';
import { postPath, type BlogPost } from '../lib/posts.ts';

interface Props {
  post: BlogPost;
  /** Nivel del título según la página (h2 en listados sin encabezado de sección, h3 debajo de uno). */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
// La tarjeta habla el idioma de su post (los listados solo muestran posts del idioma de la página).
const t = ui(post.lang);
const eyebrow = post.tags[0]?.name ?? t.article;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  <CoverMedia cover={post.cover} ratio="card" decorative />
  <p class="eyebrow">{eyebrow}</p>
  <Heading class="card-title"><a href={postPath(post)}>{post.title}</a></Heading>
  {post.description && <p class="card-dek">{post.description}</p>}
  <p class="meta">
    <time datetime={post.publishedAt.toISOString()}>{formatDate(post.lang, post.publishedAt)}</time> ·{' '}
    {interpolate(t.minutes, { n: post.readingMinutes })}
  </p>
</article>
