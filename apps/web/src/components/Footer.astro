---
import { navLinks, paths, ui, type Lang } from '../lib/i18n.ts';
import { contactLinks, getSettings } from '../lib/settings.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const settings = await getSettings(lang);
const t = ui(lang);
const contact = contactLinks(settings);
// RSS has its own column ("Subscribe").
const explore = navLinks(lang).filter((item) => item.href !== paths.rss(lang));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-brand-col">
    <p class="footer-brand"><a href={paths.home(lang)}>{settings.name}</a></p>
    <p class="footer-tagline">{settings.tagline}</p>
    <p class="footer-legal">© {year} {settings.name}</p>
  </div>
  {
    contact.length > 0 && (
      <nav class="footer-col" aria-labelledby="footer-contact">
        <h2 id="footer-contact">{t.contact}</h2>
        <ul>
          {contact.map((link) => (
            <li>
              <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <nav class="footer-col" aria-labelledby="footer-explore">
    <h2 id="footer-explore">{t.explore}</h2>
    <ul>
      <li><a href={paths.home(lang)}>{t.home}</a></li>
      {
        explore.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class="footer-col" aria-labelledby="footer-subscribe">
    <h2 id="footer-subscribe">{t.subscribe}</h2>
    <ul>
      <li><a href={paths.rss(lang)} type="application/rss+xml" aria-label={t.rssLabel}>{t.rss}</a></li>
    </ul>
  </nav>
</footer>
