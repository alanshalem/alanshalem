---
import { contactLinks, getSettings } from '../lib/settings.ts';
import { site } from '../lib/site.ts';

const settings = await getSettings();
const contact = contactLinks(settings);
const explore = site.nav.filter((item) => item.href !== '/rss.xml');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-brand-col">
    <p class="footer-brand"><a href="/">{settings.name}</a></p>
    <p class="footer-tagline">{settings.tagline}</p>
    <p class="footer-legal">© {year} {settings.author}</p>
  </div>
  {
    contact.length > 0 && (
      <nav class="footer-col" aria-labelledby="footer-contacto">
        <h2 id="footer-contacto">Contacto</h2>
        <ul>
          {contact.map((link) => (
            <li>
              <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <nav class="footer-col" aria-labelledby="footer-explorar">
    <h2 id="footer-explorar">Explorar</h2>
    <ul>
      <li><a href="/">Inicio</a></li>
      {
        explore.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class="footer-col" aria-labelledby="footer-suscribirse">
    <h2 id="footer-suscribirse">Suscribirse</h2>
    <ul>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </nav>
</footer>
