---
import '@blog/tokens/tokens.css';
import '@blog/tokens/prose.css';
import '../styles/site.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { hreflangLinks, ogLocale, paths, ui, type Alternates, type Lang } from '../lib/i18n.ts';
import { getSettings } from '../lib/settings.ts';
import { absoluteUrl } from '../lib/site.ts';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Ruta del sitio con barra final, ej: "/es/articulos/mi-post/". Define la URL canónica. */
  path: string;
  /** La misma página en otros idiomas (hreflang y selector ES | EN). Sin ella, el selector va a las homes. */
  alternates?: Alternates;
  /** Destino del selector para los idiomas sin versión equivalente (por defecto, su home). */
  switchFallback?: (lang: Lang) => string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  /** URL absoluta de una imagen real para og:image (nunca la portada generativa). */
  image?: string | undefined;
  imageAlt?: string | undefined;
  /** La página empieza con un hero oscuro a pantalla completa: la cabecera va transparente encima. */
  overlayHeader?: boolean;
}

const {
  lang,
  title,
  path,
  alternates = {},
  switchFallback,
  type = 'website',
  noindex = false,
  publishedTime,
  image,
  imageAlt,
  overlayHeader = false,
} = Astro.props;
const settings = await getSettings(lang);
const description = Astro.props.description ?? settings.tagline;
const fullTitle = path === paths.home(lang) ? settings.name : `${title} · ${settings.name}`;
const canonical = absoluteUrl(path);
const t = ui(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {hreflangLinks(alternates).map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={absoluteUrl(href)} />)}

    <meta property="og:site_name" content={settings.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {image && <meta property="og:image" content={image} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title={settings.name} href={paths.rss(lang)} />

    <!-- Solo las fuentes que se ven sin hacer scroll; el resto carga cuando hace falta. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pagella-regular-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/gloock-latin.woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.skipToContent}</a>
    <Header lang={lang} currentPath={path} alternates={alternates} switchFallback={switchFallback} overlay={overlayHeader} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
