---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { renderMarkdown } from '@blog/markdown';
import CoverMedia from '../../components/CoverMedia.astro';
import PostCard from '../../components/PostCard.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteImageUrl } from '../../lib/cover.ts';
import { generativeCover } from '../../lib/generative.ts';
import { getHeroImages, heroShareImage, localizeHeroImage, resolveHero } from '../../lib/hero.ts';
import { HERO_ELEMENT_IDS, HERO_ROTATION_SCRIPT } from '../../lib/hero-rotation.ts';
import { jsonForScript } from '../../lib/html.ts';
import { LANGS, alternatesFor, articleCount, formatDate, interpolate, paths, ui, type Lang } from '../../lib/i18n.ts';
import { getPosts, homeSections, postPath, postsIn } from '../../lib/posts.ts';
import { IMAGE_SIZES } from '../../lib/responsive-image.ts';
import { getSettings } from '../../lib/settings.ts';
import { absoluteUrl } from '../../lib/site.ts';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang }, props: { lang } }));

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const settings = await getSettings(lang);
const posts = postsIn(await getPosts(), lang);
const { featured, latest, more, topics: tags } = homeSections(posts);

// Hero: the admin's gallery (rotates on every visit), or public/hero.jpg if someone left it there; else typographic.
// The same script in both languages: only the slides' texts (alt, credit) change.
const heroJpgExists = existsSync(join(process.cwd(), 'public', 'hero.jpg'));
const hero = resolveHero((await getHeroImages()).map((image) => localizeHeroImage(image, lang)), heroJpgExists);
const shareImage = heroShareImage(hero);
const bioHtml = settings.bio ? renderMarkdown(settings.bio, { headingOffset: 2 }).html : null;
---

<BaseLayout
  lang={lang}
  title={settings.name}
  path={paths.home(lang)}
  alternates={alternatesFor(paths.home)}
  overlayHeader
  image={shareImage ? absoluteImageUrl(shareImage.src, absoluteUrl(paths.home(lang))) : undefined}
  imageAlt={shareImage?.alt}
>
  <section class:list={['hero', { 'hero--photo': hero, 'hero--type': !hero }]} aria-labelledby="hero-title">
    {
      hero?.kind === 'static' && (
        <div class="hero-bg" data-media>
          <ResponsiveImage src={hero.src} alt="" context="hero" priority width={1920} height={1080} />
        </div>
      )
    }
    <div class="hero-body">
      <h1 id="hero-title">{settings.name}</h1>
      {bioHtml ? <div class="hero-dek" set:html={bioHtml} /> : <p class="hero-dek">{settings.tagline}</p>}
      <p class="entry-links">
        <a href={posts.length > 0 ? '#latest' : paths.posts(lang)}>{t.heroLatest}</a>
        <a href={paths.tags(lang)}>{t.topics}</a>
        <a href={paths.rss(lang)}>{t.rss}</a>
      </p>
    </div>
    {hero?.kind === 'gallery' && <p class="hero-credit" id={HERO_ELEMENT_IDS.credit}>{hero.slides[0]?.credit}</p>}
    {
      /*
        Background and Play/Pause button in the same media container: if the photo or the video fails, the guard
        (lib/media-guard.ts) hides both together and no control of a broken video is left. `.hero-media` makes no box
        (display: contents), so the background still covers the hero and the button sits like any other child. It goes
        last so that, with the keyboard, the button comes after the hero links, where it is seen.
      */
      hero?.kind === 'gallery' && (
        <div class="hero-media" data-media>
          <div class="hero-bg">
            {/*
              Empty on purpose: the script below picks a photo or video; it fills these three children (in this
              order) or puts the video on top.
            */}
            <picture id={HERO_ELEMENT_IDS.picture} class="hero-picture">
              <source type="image/avif" sizes={IMAGE_SIZES.hero} />
              <source type="image/webp" sizes={IMAGE_SIZES.hero} />
              <img alt="" decoding="async" fetchpriority="high" />
            </picture>
            {/* Without JS, the gallery's first item as a photo (for a video, its poster: `media`). */}
            <noscript>
              <ResponsiveImage
                src={hero.first.media.url}
                alt={hero.first.alt}
                context="hero"
                priority
                width={hero.first.media.width}
                height={hero.first.media.height}
              />
            </noscript>
          </div>
          {/*
            WCAG 2.2.2. Hidden without JS and for photos; the script shows it for a video. Both texts come from the
            dictionary and the CSS leaves one visible depending on the state class: the accessible name is always the
            visible one (the icons are aria-hidden; U+FE0E keeps ▶ from rendering as an emoji).
          */}
          <button id={HERO_ELEMENT_IDS.toggle} class="hero-toggle" type="button" hidden>
            <span class="hero-toggle-play"><span aria-hidden="true">{'\u25B6\uFE0E'}</span>{t.heroPlay}</span>
            <span class="hero-toggle-pause"><span aria-hidden="true">{'\u275A\u275A'}</span>{t.heroPause}</span>
          </button>
        </div>
      )
    }
  </section>
  {
    hero?.kind === 'gallery' && (
      <>
        <script is:inline type="application/json" id={HERO_ELEMENT_IDS.slides} set:html={jsonForScript(hero.slides)} />
        <script is:inline set:html={HERO_ROTATION_SCRIPT} />
      </>
    )
  }

  {
    !featured && (
      <section class="section">
        <div class="section-head">
          <h2>{t.latest}</h2>
        </div>
        <p class="empty">{t.noPosts}</p>
      </section>
    )
  }

  {
    featured && (
      <section class="section" id="latest" aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title">{t.latest}</h2>
          <a href={paths.posts(lang)}>{t.allPosts}</a>
        </div>

        <article class="lead">
          <CoverMedia cover={featured.cover} ratio="lead" eager={!hero} decorative />
          <div class="lead-body">
            <p class="eyebrow">{featured.tags.length > 0 ? featured.tags.map((tag) => tag.name).join(' · ') : t.article}</p>
            <h3 class="lead-title">
              <a href={postPath(featured)}>{featured.title}</a>
            </h3>
            {featured.description && <p class="lead-dek">{featured.description}</p>}
            <p class="meta">
              <time datetime={featured.publishedAt.toISOString()}>{formatDate(lang, featured.publishedAt)}</time> ·{' '}
              {interpolate(t.readingTime, { n: featured.readingMinutes })}
            </p>
            {featured.cover.kind === 'image' && featured.cover.alt && <p class="lead-credit">{featured.cover.alt}</p>}
          </div>
        </article>

        {
          latest.length > 0 && (
            <div class="card-grid card-grid--row">
              {latest.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          )
        }
      </section>
    )
  }

  {
    more.length > 0 && (
      <section class="section" aria-labelledby="more-title">
        <div class="section-head">
          <h2 id="more-title">{t.morePosts}</h2>
          <a href={paths.posts(lang)}>{t.fullArchive}</a>
        </div>
        <ol class="numbered">
          {more.map((post, i) => (
            <li>
              <span class="numbered-n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>
                  <a href={postPath(post)}>{post.title}</a>
                </h3>
                {post.description && <p>{post.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section class="section" aria-labelledby="topics-title">
        <div class="section-head">
          <h2 id="topics-title">{t.topics}</h2>
          <a href={paths.tags(lang)}>{t.allTopics}</a>
        </div>
        <ul class="tiles">
          {tags.map(({ tag, posts: tagPosts }) => (
            <li class="tile">
              <CoverMedia cover={{ kind: 'generative', svg: generativeCover(`tema:${tag.slug}`, tag.slug) }} ratio="tile" />
              <div class="tile-body">
                <h3 class="tile-title">
                  <a href={paths.tag(lang, tag.slug)}>{tag.name}</a>
                </h3>
                <p class="meta">{articleCount(lang, tagPosts.length)}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
