---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, alternatesFor, articleCount, paths, segments, ui, type Lang } from '../../../lib/i18n.ts';
import { getPosts, postsIn, tagsOf } from '../../../lib/posts.ts';

// [topics] is the translated segment (temas / topics): one page for both languages.
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang, topics: segments(lang).topics }, props: { lang } }));

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const tags = tagsOf(postsIn(await getPosts(), lang));
---

<BaseLayout lang={lang} title={t.topics} description={t.topicsDescription} path={paths.tags(lang)} alternates={alternatesFor(paths.tags)}>
  <header class="page-head">
    <h1>{t.topics}</h1>
    <p class="page-dek">{t.topicsDek}</p>
  </header>

  <section class="section section--flush" aria-label={t.topicsList}>
    {tags.length === 0 && <p class="empty">{t.noTopics}</p>}
    {
      tags.length > 0 && (
        <ul class="chip-cloud">
          {tags.map(({ tag, posts }) => (
            <li>
              <a href={paths.tag(lang, tag.slug)}>
                {tag.name} <span class="count" aria-hidden="true">{posts.length}</span>
                <span class="visually-hidden">({articleCount(lang, posts.length)})</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
