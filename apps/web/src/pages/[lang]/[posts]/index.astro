---
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LANGS, alternatesFor, articleCount, paths, segments, ui, type Lang } from '../../../lib/i18n.ts';
import { getPosts, postsByYear, postsIn } from '../../../lib/posts.ts';

// [posts] is the translated segment (articulos / articles): one page for both languages.
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang, posts: segments(lang).posts }, props: { lang } }));

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const posts = postsIn(await getPosts(), lang);
const years = postsByYear(posts);
---

<BaseLayout lang={lang} title={t.posts} description={t.postsDescription} path={paths.posts(lang)} alternates={alternatesFor(paths.posts)}>
  <header class="page-head">
    <h1>{t.posts}</h1>
    <p class="page-dek">{t.postsDek}{posts.length > 0 && <> · {articleCount(lang, posts.length)}</>}.</p>
  </header>

  <section class="section section--flush" aria-label={t.postsArchive}>
    {posts.length === 0 && <p class="empty">{t.noPosts}</p>}
    {
      years.map(({ year, posts: yearPosts }) => (
        <div class="year-block">
          <h2 class="year">{year}</h2>
          <div class="card-grid">
            {yearPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
