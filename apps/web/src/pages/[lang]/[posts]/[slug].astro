---
import CoverMedia from '../../../components/CoverMedia.astro';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { absoluteImageUrl } from '../../../lib/cover.ts';
import { formatDate, interpolate, paths, segments, ui, type Alternates } from '../../../lib/i18n.ts';
import { getMediaIndex } from '../../../lib/media.ts';
import { alternatesByGroup, getPosts, postPath, postsIn, type BlogPost } from '../../../lib/posts.ts';
import { responsiveProseHtml } from '../../../lib/responsive-image.ts';
import { absoluteUrl } from '../../../lib/site.ts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const alternates = alternatesByGroup(posts);
  return posts.map((post) => ({
    params: { lang: post.lang, posts: segments(post.lang).posts, slug: post.slug },
    props: {
      post,
      // Sus otras versiones publicadas (hreflang y selector ES | EN).
      alternates: alternates.get(post.translationGroupId) ?? {},
      // "Seguir leyendo": los 3 posts más nuevos de su idioma que no sean este.
      readNext: postsIn(posts, post.lang)
        .filter((other) => other.slug !== post.slug)
        .slice(0, 3),
    },
  }));
}

interface Props {
  post: BlogPost;
  alternates: Alternates;
  readNext: BlogPost[];
}

const { post, alternates, readNext } = Astro.props;
const { lang } = post;
const t = ui(lang);
// El índice lateral lista solo h2 y h3: más profundidad ensucia más de lo que ayuda.
const toc = post.headings.filter((heading) => heading.level <= 3);
const image = post.cover.kind === 'image' ? post.cover : null;
// Solo en la página: el feed RSS conserva las <img> simples que entienden todos los lectores.
const proseHtml = responsiveProseHtml(post.html, await getMediaIndex());
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  path={postPath(post)}
  alternates={alternates}
  type="article"
  publishedTime={post.publishedAt}
  image={image ? absoluteImageUrl(image.src, absoluteUrl(postPath(post))) : undefined}
  imageAlt={image?.alt || undefined}
  overlayHeader
>
  <header class="article-hero">
    <CoverMedia cover={post.cover} ratio="hero" eager />
    <div class="article-hero-body">
      {
        post.tags.length > 0 && (
          <p class="eyebrow">
            {post.tags.map((tag, i) => (
              <>
                {i > 0 && ' · '}
                <a href={paths.tag(lang, tag.slug)}>{tag.name}</a>
              </>
            ))}
          </p>
        )
      }
      <h1>{post.title}</h1>
      {post.description && <p class="article-dek">{post.description}</p>}
      <p class="meta">
        <time datetime={post.publishedAt.toISOString()}>{formatDate(lang, post.publishedAt)}</time> ·{' '}
        {interpolate(t.readingTime, { n: post.readingMinutes })}
      </p>
    </div>
  </header>

  {
    image?.alt && (
      <aside class="image-strip" aria-label={t.aboutImage}>
        <span class="eyebrow">{t.aboutImage}</span>
        <span>{image.alt}</span>
      </aside>
    )
  }

  <div class="paper reading">
    <div class="reading-grid">
      {
        toc.length > 1 && (
          <nav class="toc" aria-label={t.tocNav}>
            <p class="toc-label">{t.tocLabel}</p>
            <ol>
              {toc.map((heading) => (
                <li class={`toc-level-${heading.level}`}>
                  <a href={`#${heading.id}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <article class="prose" set:html={proseHtml} />
      {
        post.tags.length > 0 && (
          <footer class="end-matter">
            <p class="end-label">{t.topics}</p>
            <ul class="tag-list">
              {post.tags.map((tag) => (
                <li>
                  <a href={paths.tag(lang, tag.slug)}>{tag.name}</a>
                </li>
              ))}
            </ul>
          </footer>
        )
      }
    </div>
  </div>

  {
    readNext.length > 0 && (
      <section class="section" aria-labelledby="seguir-title">
        <div class="section-head">
          <h2 id="seguir-title">{t.readNext}</h2>
          <a href={paths.posts(lang)}>{t.allPosts}</a>
        </div>
        <div class="card-grid card-grid--row">
          {readNext.map((other) => (
            <PostCard post={other} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Mejora progresiva: resalta en el índice la sección que se está leyendo. Sin JS, el índice funciona igual.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((link) => links.set(link.hash.slice(1), link));

  if (links.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((link) => link.removeAttribute('aria-current'));
            links.get(entry.target.id)?.setAttribute('aria-current', 'true');
          }
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    });
  }
</script>
