---
import { DEFAULT_LANG, LANGS, LANGUAGE_NAMES, paths } from '../lib/i18n.ts';
import { absoluteUrl } from '../lib/site.ts';

// In production Caddy redirects `/` by Accept-Language before it gets here. This file covers servers without that
// rule (astro dev, astro preview): it goes straight to the main language, without JS. No layout or API on purpose.
const target = paths.home(DEFAULT_LANG);
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absoluteUrl(target)} />
    <title>{LANGS.map((lang) => LANGUAGE_NAMES[lang]).join(' · ')}</title>
  </head>
  <body>
    <p>
      {
        LANGS.map((lang, i) => (
          <>
            {i > 0 && ' · '}
            <a href={paths.home(lang)} hreflang={lang} lang={lang}>{LANGUAGE_NAMES[lang]}</a>
          </>
        ))
      }
    </p>
  </body>
</html>
