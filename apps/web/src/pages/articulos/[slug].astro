---
import CoverMedia from '../../components/CoverMedia.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteImageUrl } from '../../lib/cover.ts';
import { getMediaIndex } from '../../lib/media.ts';
import { getPosts, postPath, tagPath, type BlogPost } from '../../lib/posts.ts';
import { responsiveProseHtml } from '../../lib/responsive-image.ts';
import { absoluteUrl, formatDate } from '../../lib/site.ts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      // "Seguir leyendo": los 3 posts más nuevos que no sean este.
      readNext: posts.filter((other) => other.slug !== post.slug).slice(0, 3),
    },
  }));
}

interface Props {
  post: BlogPost;
  readNext: BlogPost[];
}

const { post, readNext } = Astro.props;
// El índice lateral lista solo h2 y h3: más profundidad ensucia más de lo que ayuda.
const toc = post.headings.filter((heading) => heading.level <= 3);
const image = post.cover.kind === 'image' ? post.cover : null;
// Solo en la página: el feed RSS conserva las <img> simples que entienden todos los lectores.
const proseHtml = responsiveProseHtml(post.html, await getMediaIndex());
---

<BaseLayout
  title={post.title}
  description={post.description}
  path={postPath(post)}
  type="article"
  publishedTime={post.publishedAt}
  image={image ? absoluteImageUrl(image.src, absoluteUrl(postPath(post))) : undefined}
  imageAlt={image?.alt || undefined}
  overlayHeader
>
  <header class="article-hero">
    <CoverMedia cover={post.cover} ratio="hero" eager />
    <div class="article-hero-body">
      {
        post.tags.length > 0 && (
          <p class="eyebrow">
            {post.tags.map((tag, i) => (
              <>
                {i > 0 && ' · '}
                <a href={tagPath(tag)}>{tag.name}</a>
              </>
            ))}
          </p>
        )
      }
      <h1>{post.title}</h1>
      {post.description && <p class="article-dek">{post.description}</p>}
      <p class="meta">
        <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time> · {post.readingMinutes} min
        de lectura
      </p>
    </div>
  </header>

  {
    image?.alt && (
      <aside class="image-strip" aria-label="Sobre la imagen">
        <span class="eyebrow">Sobre la imagen</span>
        <span>{image.alt}</span>
      </aside>
    )
  }

  <div class="paper reading">
    <div class="reading-grid">
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="Índice del artículo">
            <p class="toc-label">En esta página</p>
            <ol>
              {toc.map((heading) => (
                <li class={`toc-level-${heading.level}`}>
                  <a href={`#${heading.id}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <article class="prose" set:html={proseHtml} />
      {
        post.tags.length > 0 && (
          <footer class="end-matter">
            <p class="end-label">Temas</p>
            <ul class="tag-list">
              {post.tags.map((tag) => (
                <li>
                  <a href={tagPath(tag)}>{tag.name}</a>
                </li>
              ))}
            </ul>
          </footer>
        )
      }
    </div>
  </div>

  {
    readNext.length > 0 && (
      <section class="section" aria-labelledby="seguir-title">
        <div class="section-head">
          <h2 id="seguir-title">Seguir leyendo</h2>
          <a href="/articulos/">Todos los artículos</a>
        </div>
        <div class="card-grid card-grid--row">
          {readNext.map((other) => (
            <PostCard post={other} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Mejora progresiva: resalta en el índice la sección que se está leyendo. Sin JS, el índice funciona igual.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((link) => links.set(link.hash.slice(1), link));

  if (links.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((link) => link.removeAttribute('aria-current'));
            links.get(entry.target.id)?.setAttribute('aria-current', 'true');
          }
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    });
  }
</script>
