---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, type BlogPost } from '../../lib/posts.ts';
import { yearOf } from '../../lib/site.ts';

const posts = await getPosts();

// Agrupado por año (los posts ya vienen del más nuevo al más viejo).
const byYear = new Map<number, BlogPost[]>();
for (const post of posts) {
  const year = yearOf(post.publishedAt);
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const count = posts.length === 1 ? '1 artículo' : `${posts.length} artículos`;
---

<BaseLayout title="Artículos" description="Todos los artículos, por año." path="/articulos/">
  <header class="page-head">
    <h1>Artículos</h1>
    <p class="page-dek">Todo lo publicado, del más nuevo al más viejo{posts.length > 0 && <> · {count}</>}.</p>
  </header>

  <section class="section section--flush" aria-label="Archivo por año">
    {posts.length === 0 && <p class="empty">Todavía no hay artículos publicados.</p>}
    {
      [...byYear].map(([year, yearPosts]) => (
        <div class="year-block">
          <h2 class="year">{year}</h2>
          <div class="card-grid">
            {yearPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
