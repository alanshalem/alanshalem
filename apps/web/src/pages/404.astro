---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundPage, paths, ui } from '../lib/i18n.ts';

// Una sola página para los tres 404 (L13). Astro la genera como /404.html y, desde pages/[lang]/404.html.ts, como
// /es/404.html y /en/404.html: `originPathname` es la URL desde la que se pidió. Bajo un idioma, todo va en ese
// idioma; en /404.html (URLs sin prefijo, para las que no se sabe en qué idioma lee quien llegó) el aviso va en los
// dos y cabecera y pie en el principal. Un solo h1, el del idioma de la página; el aviso en el otro es un h2 con el
// mismo estilo.
const { lang, notices } = notFoundPage(Astro.originPathname);
const t = ui(lang);
const path = notices.length === 1 ? paths.notFound(lang) : '/404/';
---

<BaseLayout lang={lang} title={t.notFoundTitle} path={path} noindex>
  {
    notices.map((notice) => (
      <header class="page-head page-head--404" lang={notice}>
        <p class="eyebrow">{ui(notice).notFoundEyebrow}</p>
        {notice === lang ? <h1>{ui(notice).notFoundHeading}</h1> : <h2 class="page-head-title">{ui(notice).notFoundHeading}</h2>}
        <p class="page-dek">{ui(notice).notFoundDek}</p>
        <p class="entry-links">
          <a href={paths.home(notice)}>{ui(notice).backHome}</a>
          <a href={paths.posts(notice)}>{ui(notice).posts}</a>
          <a href={paths.tags(notice)}>{ui(notice).topics}</a>
        </p>
      </header>
    ))
  }
</BaseLayout>
