---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundLang, paths, ui } from '../lib/i18n.ts';

// One page for the 404s, in one language. Astro generates it as /es/404.html and /en/404.html from
// pages/[lang]/404.html.ts (`originPathname` is the URL it was requested from), and also as /404.html, in the main
// language: Caddy never serves that one (URLs without a prefix get the one of the browser's language), but this page
// must exist as the rewrite target and it is what `astro dev` shows for a missing route.
const lang = notFoundLang(Astro.originPathname);
const t = ui(lang);
---

<BaseLayout lang={lang} title={t.notFoundTitle} path={paths.notFound(lang)} noindex>
  <header class="page-head page-head--404">
    <p class="eyebrow">{t.notFoundEyebrow}</p>
    <h1>{t.notFoundHeading}</h1>
    <p class="page-dek">{t.notFoundDek}</p>
    <p class="entry-links">
      <a href={paths.home(lang)}>{t.backHome}</a>
      <a href={paths.posts(lang)}>{t.posts}</a>
      <a href={paths.tags(lang)}>{t.topics}</a>
    </p>
  </header>
</BaseLayout>
