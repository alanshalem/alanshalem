---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LANG, LANGS, paths, ui } from '../lib/i18n.ts';

// Caddy sirve un único /404.html para cualquier ruta inexistente y un HTML estático no sabe desde qué URL se pidió:
// el aviso va en los dos idiomas (sin JS ni reglas de servidor extra). Cabecera y pie, en el idioma principal.
// Un solo h1, el del idioma principal; el aviso en el otro idioma es un h2 con el mismo estilo.
const t = ui(DEFAULT_LANG);
---

<BaseLayout lang={DEFAULT_LANG} title={t.notFoundTitle} path="/404/" noindex>
  {
    LANGS.map((lang) => (
      <header class="page-head page-head--404" lang={lang}>
        <p class="eyebrow">{ui(lang).notFoundEyebrow}</p>
        {lang === DEFAULT_LANG ? <h1>{ui(lang).notFoundHeading}</h1> : <h2 class="page-head-title">{ui(lang).notFoundHeading}</h2>}
        <p class="page-dek">{ui(lang).notFoundDek}</p>
        <p class="entry-links">
          <a href={paths.home(lang)}>{ui(lang).backHome}</a>
          <a href={paths.posts(lang)}>{ui(lang).posts}</a>
          <a href={paths.tags(lang)}>{ui(lang).topics}</a>
        </p>
      </header>
    ))
  }
</BaseLayout>
