---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags, tagPath, type BlogPost, type Tag } from '../../lib/posts.ts';

export async function getStaticPaths() {
  return (await getTags()).map(({ tag, posts }) => ({ params: { tag: tag.slug }, props: { tag, posts } }));
}

interface Props {
  tag: Tag;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
const count = posts.length === 1 ? '1 artículo' : `${posts.length} artículos`;
---

<BaseLayout title={tag.name} description={`Artículos sobre ${tag.name}.`} path={tagPath(tag)}>
  <header class="page-head">
    <p class="eyebrow"><a href="/temas/">Temas</a></p>
    <h1>{tag.name}</h1>
    <p class="page-dek">{count}</p>
  </header>

  <section class="section section--flush" aria-label={`Artículos sobre ${tag.name}`}>
    <div class="card-grid">
      {posts.map((post) => <PostCard post={post} headingLevel={2} />)}
    </div>
  </section>
</BaseLayout>
