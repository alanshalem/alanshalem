---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags, tagPath } from '../../lib/posts.ts';

const tags = await getTags();
---

<BaseLayout title="Temas" description="Los artículos agrupados por tema." path="/temas/">
  <header class="page-head">
    <h1>Temas</h1>
    <p class="page-dek">Los artículos agrupados por tema. El número indica cuántos hay en cada uno.</p>
  </header>

  <section class="section section--flush" aria-label="Lista de temas">
    {tags.length === 0 && <p class="empty">Todavía no hay temas.</p>}
    {
      tags.length > 0 && (
        <ul class="chip-cloud">
          {tags.map(({ tag, posts }) => (
            <li>
              <a href={tagPath(tag)}>
                {tag.name} <span class="count">{posts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
