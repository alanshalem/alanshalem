<Project Sdk="Microsoft.NET.Sdk">
  <!-- Technical details: SQLite (EF Core), disk, images (libvips), HTTP to the builder, password hashing. -->
  <ItemGroup>
    <ProjectReference Include="..\Blog.Application\Blog.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests check the ffmpeg filter graphs, which are an internal detail of the adapter. -->
    <InternalsVisibleTo Include="Blog.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Brings Options, Logging, DI and IHttpClientFactory without adding loose packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- libvips: decodes with shrink-on-load and encodes AVIF/WebP with little memory. The Native packages bring the
         library already compiled (with libheif + aom for AVIF) for development on Windows and for the Linux container. -->
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native.linux-x64" />
    <PackageReference Include="NetVips.Native.win-x64" />
    <!-- Only for dotnet-ef (generating migrations). PrivateAssets: it does not ship with the published API. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
