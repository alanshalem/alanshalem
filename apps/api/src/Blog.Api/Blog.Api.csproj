<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Blog.Application\Blog.Application.csproj" />
    <ProjectReference Include="..\Blog.Infrastructure\Blog.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests call the command-line modes (Cli/) without starting a separate process. -->
    <InternalsVisibleTo Include="Blog.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Less resident memory: this process shares a VPS with other apps. -->
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UserSecretsId>66891b4d-dd09-4d5b-8fcb-b3af1627a333</UserSecretsId>
    <!-- data/ holds the SQLite database, the media and the videos being processed by `dotnet run`: data, not code. Kept
         out of the project files, `dotnet watch` does not restart the API every time the database writes, and nothing
         there is published. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);data/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
