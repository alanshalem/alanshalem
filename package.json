{
  "name": "blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:profile && pnpm test:agents && pnpm test:infra",
    "test:profile": "node --test \"tooling/profile/test/*.test.ts\"",
    "test:infra": "node --test \"infra/test/*.test.ts\"",
    "profile": "node tooling/profile/generate.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:admin": "pnpm --filter @blog/admin dev",
    "build:web": "pnpm --filter @blog/web build",
    "build:admin": "pnpm --filter @blog/admin build",
    "test:agents": "node --test \"tooling/agents/test/*.test.ts\"",
    "agents:sync": "node tooling/agents/sync.ts",
    "agents:check": "node tooling/agents/sync.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
