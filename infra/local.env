# ONLY FOR YOUR PC: test values for the local production copy (compose.local.yml) and for development with Docker
# (compose.dev.yml); both start with --env-file pointing here. They are in the repo on purpose; never use them on the
# VPS (there it is .env, made from .env.example).
#
# Admin password: admin. To change it, generate another hash (see README, "Local production copy") and paste it here
# in single quotes (the hash has $): it works for both. LOCAL_PORT and SITE_URL are only for the local copy.

SITE_ADDRESS=:80
LOCAL_PORT=8080
SITE_URL=http://localhost:${LOCAL_PORT}
ADMIN_PASSWORD_HASH='pbkdf2-sha256$600000$+7ihVRZYczkK6o+cjmJpBA==$D83+jY2BckGSJHjiSJ8yYV8NHm6Uwc6+hVxfK4rGvzc='
BUILDER_TOKEN=local-only-builder-token-not-a-secret-0000
