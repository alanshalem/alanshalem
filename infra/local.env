# SOLO PARA TU PC: valores de prueba de la copia local de producción (compose.local.yml). Están en el repo a propósito;
# nunca los uses en el VPS (allá va .env, a partir de .env.example).
#
# Contraseña del admin: admin. Para cambiarla, generá otro hash (ver README, "Copia local de producción") y pegalo
# acá entre comillas simples (el hash tiene $). Los mismos valores son los que usa compose.dev.yml por defecto.

SITE_ADDRESS=:80
LOCAL_PORT=8080
SITE_URL=http://localhost:${LOCAL_PORT}
ADMIN_PASSWORD_HASH='pbkdf2-sha256$600000$+7ihVRZYczkK6o+cjmJpBA==$D83+jY2BckGSJHjiSJ8yYV8NHm6Uwc6+hVxfK4rGvzc='
BUILDER_TOKEN=local-only-builder-token-not-a-secret-0000
