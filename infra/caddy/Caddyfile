# Caddy: TLS automático (Let's Encrypt), HTTP/2 y HTTP/3, y sirve TODO lo público directo desde disco.
# La API solo atiende /api (login, editor, subida de imágenes). Los visitantes nunca tocan .NET ni Node.
#
# SITE_ADDRESS = tu dominio (ej: blog.midominio.com). Para probar local: localhost

# Cabeceras de seguridad de toda respuesta. En un snippet porque las rutas de error (handle_errors) no pasan por las
# directivas del sitio: sin importarlo también ahí, un 404 salía sin nosniff, X-Frame-Options ni HSTS (y con Server).
(security) {
	header {
		# Sin includeSubDomains a propósito: este VPS va a alojar otras apps y no quiero forzar HTTPS en sus subdominios por accidente.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		-Server
	}
}

{$SITE_ADDRESS:localhost} {
	import security

	# ---------- API ----------
	# Sin request_body max_size a propósito: Caddy no limita ni bufferiza el cuerpo (lo pasa en streaming) y el único
	# tope es el de Kestrel en la API (12 MB en general, 200 MB en /api/admin/media/videos), así no hay dos que mantener.
	handle /api/* {
		# /api/internal lo lee el builder por la red interna de Docker: hacia afuera no existe. Va dentro del handle: ahí
		# respond corre antes que reverse_proxy (afuera, Caddy evalúa handle primero y la regla nunca se aplicaba).
		@internal path /api/internal /api/internal/*
		# `respond` no pasa por handle_errors: el no-store va acá (si no, este 404 quedaría sin Cache-Control).
		header @internal Cache-Control "no-store"
		respond @internal 404
		# Lo del panel es privado y cambia con cada guardado: ni el navegador ni un proxy intermedio lo guardan. Lo pone Caddy,
		# que decide la caché de todas las rutas del sitio en este archivo. `>` (diferido) reemplaza el Cache-Control que
		# mande la API en vez de sumar un segundo valor.
		@admin path /api/admin/*
		header @admin >Cache-Control "no-store"
		encode zstd gzip
		reverse_proxy api:8080 {
			# Si la API se cae, Caddy deja de mandarle tráfico y responde 503 en vez de colgarse. Cada 2 s: tras arrancar o
			# un deploy (el primer chequeo suele caer mientras .NET arranca), /api vuelve a los pocos segundos y no a los 30.
			# 3 fallos seguidos para sacarla: un chequeo lento suelto no la deja afuera.
			health_uri /api/health
			health_interval 2s
			health_fails 3
		}
	}

	# ---------- Panel de administración (SPA de React ya compilada) ----------
	handle_path /admin/* {
		root * /srv/admin
		# blob: en img-src y media-src: la vista previa local de fotos y el editor de recorte de videos usan URLs de objeto
		# (el archivo todavía no se subió). Los videos ya procesados vienen de /media ('self').
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		# Los assets llevan el hash del contenido en el nombre: para siempre. Todo lo demás (index.html, que apunta a los
		# assets de turno) se revalida. Los dos con matcher, sin solaparse: Caddy ordena los `header` iguales dejando el
		# que no tiene matcher al final, y un no-cache suelto pisaba el immutable.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		# Una SPA: cualquier ruta que no sea un archivo devuelve index.html. Solo fuera de /assets/: un asset con hash que no
		# existe (pestaña vieja durante un deploy) tiene que dar 404 (no-store en handle_errors) y no index.html con el
		# immutable de @hashed, que dejaría ese navegador con el admin roto por un año. `rewrite` y no `try_files`:
		# try_files no admite matcher (tomaría `@spa` como un archivo más).
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		# Los .br y .gz se generan al construir la imagen (infra/caddy/Dockerfile), como hace el builder con el sitio.
		file_server {
			precompressed br gzip
		}
	}

	# ---------- Imágenes y videos subidos ----------
	# Los nombres salen del hash del contenido y nunca cambian: se pueden cachear para siempre. Sin encode: AVIF, WebP y
	# MP4 ya vienen comprimidos, y file_server responde Range (206) para que el <video> pida solo lo que necesita.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		file_server
	}

	# ---------- Raíz: idioma preferido del navegador ----------
	# El sitio vive en /es/ y /en/. Si la primera preferencia de Accept-Language es inglés va a /en/; si no, a /es/
	# (español por defecto). 302 porque depende de quién pide; Vary para que ninguna caché mezcle las respuestas.
	@root path /
	handle @root {
		header Vary Accept-Language
		@english header_regexp Accept-Language (?i)^\s*en\b
		redir @english /en/ 302
		redir * /es/ 302
	}

	# ---------- Sitio público (HTML estático) ----------
	handle {
		# `current` es un symlink que el builder cambia de forma atómica en cada publicación.
		root * /srv/site/current

		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=2592000"
		# El HTML se revalida siempre (ETag => 304 casi sin costo): una publicación nueva se ve al instante.
		@pages not path /_astro/* /fonts/*
		header @pages Cache-Control "no-cache"

		# El builder dejó cada archivo de texto ya comprimido en .br y .gz: se sirven tal cual, sin gastar CPU.
		file_server {
			precompressed br gzip
		}
	}

	# Errores: nunca se cachean (un 404 de /media o /_astro heredaba el immutable de un año, y el archivo que falta
	# puede aparecer después) y llevan las mismas cabeceras de seguridad. Vale también para los 502/503 de la API.
	handle_errors {
		import security
		header Cache-Control "no-store"
		# Página 404 del sitio en el idioma de la URL (L13): Astro genera /es/404.html y /en/404.html (todo en ese idioma)
		# y /404.html, bilingüe, para lo que no tiene prefijo. Las rewrite de un bloque son excluyentes y Caddy prueba las
		# de ruta antes que la de `*`: esa es el resto. El código de estado sigue siendo 404.
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv/site/current
			rewrite /es/* /es/404.html
			rewrite /en/* /en/404.html
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}

	log {
		output stdout
		format console
	}
}
