# Caddy: automatic TLS (Let's Encrypt), HTTP/2 and HTTP/3, and it serves EVERYTHING public straight from disk.
# The API only answers /api (login, editor, image uploads). Visitors never reach .NET or Node.
#
# SITE_ADDRESS = your domain (e.g. blog.mydomain.com). To test locally: localhost. Behind Dokploy's Traefik (which
# terminates TLS): :80, set by infra/compose.dokploy.yml.
# SITE_ENV = production (default) or staging: staging asks crawlers not to index anything (see the snippet below).

# Global options. CADDY_ACME_EMAIL carries the whole option (`email you@example.com`) or nothing: docker-compose.yml
# builds it from ACME_EMAIL, which is optional, and Caddy rejects an `email` without a value.
{
	{$CADDY_ACME_EMAIL}
	# Whom Caddy believes X-Forwarded-For and X-Forwarded-Proto from. Nobody by default: on a VPS without another proxy
	# Caddy is the edge and the visitor is whoever connects. Behind Dokploy's Traefik, compose.dokploy.yml fills
	# CADDY_TRUSTED_PROXIES with the whole option (`trusted_proxies static ...`) so the visitor's IP and https reach the
	# API. Not trusted_proxies_strict: Traefik drops the X-Forwarded-* a visitor sends and forwards exactly one address,
	# and strict parsing skips every trusted (private) address, so a visitor Traefik sees with a private address (Docker's
	# gateway) would turn into Traefik's own IP.
	servers {
		{$CADDY_TRUSTED_PROXIES}
	}
}

# Security headers of every response. In a snippet because the error routes (handle_errors) do not go through the site
# directives: without importing it there too, a 404 went out without nosniff, X-Frame-Options or HSTS (and with Server).
(security) {
	header {
		# No includeSubDomains on purpose: this VPS will host other apps and HTTPS must not be forced on their
		# subdomains by accident.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		# No window from another origin keeps a reference to this one (window.opener): stops tabnabbing and cross-site
		# leaks.
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# Nobody outside can embed the site's resources (Spectre-style side-channel reads), except /media, which overrides
	# it. Outside the block above on purpose: a block with `-Server` is applied deferred, when the response is written,
	# and it would win over /media's.
	header Cross-Origin-Resource-Policy "same-origin"
	# Staging (SITE_ENV=staging) is never indexed, not even what a crawler reaches past the basic auth. Deferred (>) so
	# it replaces the admin's own X-Robots-Tag "noindex" instead of losing to it. Production sends nothing new. @staging
	# is defined once in the site block (handle_errors sees it too; defining it here would define it twice).
	header @staging >X-Robots-Tag "noindex, nofollow"
}

{$SITE_ADDRESS:localhost} {
	import security
	# SITE_ENV comes from docker-compose.yml (production unless set).
	@staging expression {env.SITE_ENV} == "staging"

	# ---------- API ----------
	# No request_body max_size on purpose: Caddy neither limits nor buffers the body (it streams it), and the only cap is
	# the one the API sets in Kestrel (general and per video upload route), so there are not two limits to keep in sync.
	handle /api/* {
		# /api/internal is read by the builder over Docker's internal network: from outside it does not exist. It goes
		# inside the handle: there respond runs before reverse_proxy (outside, Caddy evaluates handle first and the rule
		# was never applied).
		@internal path /api/internal /api/internal/*
		# `respond` does not go through handle_errors: the no-store goes here (otherwise this 404 would have no
		# Cache-Control).
		header @internal Cache-Control "no-store"
		respond @internal 404
		# The admin panel's data is private and changes with every save: neither the browser nor an intermediate proxy
		# stores it. Caddy sets it, since it decides the caching of every route of the site in this file. `>` (deferred)
		# replaces the Cache-Control the API sends instead of adding a second value.
		@admin path /api/admin/*
		header @admin >Cache-Control "no-store"
		encode zstd gzip
		reverse_proxy api:8080 {
			# Only the visitor's IP, alone: the API believes X-Forwarded-For from Caddy and reads one address (the login
			# rate limit and the logs). {client_ip} is the address that connected, or, behind a trusted proxy (Traefik),
			# the visitor it reported; Caddy's default would append the proxy's address after it.
			header_up X-Forwarded-For {client_ip}
			# If the API goes down, Caddy stops sending it traffic and answers 503 instead of hanging. Every 2 s: after
			# a start or a deploy (the first check usually lands while .NET is starting), /api is back within a few
			# seconds and not 30. 3 failures in a row to take it out: a single slow check does not leave it out.
			health_uri /api/health
			health_interval 2s
			health_fails 3
		}
	}

	# ---------- Admin panel (React SPA, already built) ----------
	handle_path /admin/* {
		root * /srv/admin
		# The panel has nothing to index: not even the login screen shows up in a search engine.
		header X-Robots-Tag "noindex"
		# blob: in img-src and media-src: the local photo preview and the video trim editor use object URLs (the file is
		# not uploaded yet). Processed videos come from /media ('self'). https: in img-src, like the site's CSP
		# (apps/web/src/lib/csp.ts): the preview shows the Markdown's external images like the site does.
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		# Assets carry the content hash in their name: cached forever. Everything else (index.html, which points to the
		# current assets) is revalidated. Both with a matcher, not overlapping: Caddy sorts equal `header` directives
		# leaving the one without a matcher last, and a bare no-cache overrode the immutable one.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		# A SPA: any path that is not a file returns index.html. Only outside /assets/: a hashed asset that does not
		# exist (an old tab during a deploy) must give a 404 (no-store in handle_errors) and not index.html with the
		# @hashed immutable, which would leave that browser with a broken admin for a year. `rewrite` and not
		# `try_files`: try_files does not accept a matcher (it would take `@spa` as one more file).
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		# The .br and .gz files are generated when the image is built (infra/caddy/Dockerfile), as the builder does with
		# the site.
		file_server {
			precompressed br gzip
		}
	}

	# ---------- Uploaded images and videos ----------
	# Names come from the content hash and never change: they can be cached forever. No encode: AVIF, WebP and MP4 are
	# already compressed, and file_server answers Range (206) so the <video> asks only for what it needs.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		# The RSS feed carries the post bodies with their images: web readers (Feedly, Inoreader) load them from their
		# own origin, and with the security snippet's same-origin the browser would block them.
		header Cross-Origin-Resource-Policy "cross-origin"
		# restore.sh keeps new files in .restoring until it moves them into place: they are never served.
		file_server {
			hide .restoring
		}
	}

	# ---------- Root: the browser's preferred language ----------
	# The site lives under /es/ and /en/. If the first Accept-Language preference is English it goes to /en/; otherwise
	# to /es/ (Spanish by default). 302 because it depends on who asks; Vary so no cache mixes the responses.
	@root path /
	handle @root {
		header Vary Accept-Language
		@english header_regexp Accept-Language (?i)^\s*en\b
		redir @english /en/ 302
		redir * /es/ 302
	}

	# ---------- Staging: robots.txt disallows everything ----------
	# Production serves the robots.txt the site generates (with its sitemap); staging must not be crawled at all.
	@staging_robots {
		path /robots.txt
		expression {env.SITE_ENV} == "staging"
	}
	handle @staging_robots {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# ---------- Public site (static HTML) ----------
	handle {
		# `current` is a symlink the builder swaps atomically on every publish.
		root * /srv/site/current

		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=2592000"
		# HTML is always revalidated (ETag => 304 at almost no cost): a new publish shows up at once.
		@pages not path /_astro/* /fonts/*
		header @pages Cache-Control "no-cache"

		# The builder left every text file already compressed as .br and .gz: they are served as they are, without
		# spending CPU.
		file_server {
			precompressed br gzip
		}
	}

	# Errors: never cached (a 404 from /media or /_astro inherited the one-year immutable, and the missing file may
	# appear later) and they carry the same security headers. It also applies to the API's 502/503.
	handle_errors {
		import security
		header Cache-Control "no-store"
		# The site's 404 page in the URL's language: Astro generates /es/404.html and /en/404.html (all in that
		# language) and /404.html, bilingual, for what has no prefix. The rewrites of a block are mutually exclusive and
		# Caddy tries the path ones before the `*` one: that one is the rest. The status code stays 404.
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv/site/current
			rewrite /es/* /es/404.html
			rewrite /en/* /en/404.html
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}

	# One JSON line per request: it can be filtered with jq and log collectors read it without custom parsers.
	log {
		output stdout
		format json
	}
}
