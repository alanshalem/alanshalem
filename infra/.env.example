# Copiá este archivo a `.env` (que NO se sube al repo) y completalo.

# Dominio donde va a vivir el blog (el DNS tiene que apuntar a la IP del VPS). Caddy saca el certificado solo.
SITE_ADDRESS=blog.midominio.com
# La misma dirección con https://, sin barra final (la usan el RSS, el sitemap y las URLs canónicas).
SITE_URL=https://blog.midominio.com

# Secreto compartido entre la API y el builder. Generalo con:   openssl rand -hex 32
BUILDER_TOKEN=

# Hash de la contraseña del admin (la contraseña en claro nunca se guarda). Generalo con:
#   cd ../apps/api && dotnet run --project src/Blog.Api -- hash-password
# o, sin tener .NET instalado:
#   docker run --rm -it -v "$PWD/..:/src" -w /src/apps/api mcr.microsoft.com/dotnet/sdk:10.0 \
#     dotnet run --project src/Blog.Api -- hash-password
# IMPORTANTE: el hash contiene signos $, y docker compose los interpreta como variables.
# Pegalo entre comillas simples, que desactivan esa interpolación:
#   ADMIN_PASSWORD_HASH='pbkdf2-sha256$600000$...$...'
ADMIN_PASSWORD_HASH=

# Datos del sitio público (opcionales)
SITE_NAME=Mi blog
SITE_TAGLINE=Notas sobre software, ideas y cosas que estoy aprendiendo.
SITE_AUTHOR=Tu nombre
